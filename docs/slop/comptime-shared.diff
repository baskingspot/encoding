-fn maxLen(d: *const Decoder, comptime Unit: type, n: usize) ?usize {
-    const total = std.math.add(usize, n, d.pending_len) catch return null;
-    var max = codecs.decoderMaxLen(&d.state, Unit, total) orelse return null;
-    if (d.phase == .sniff) {
